{
  "version": 1,
  "说明": "GAP-31 提示词效果回归集的离线样例集。fixture 是「录制下来的模型产出」，跑批时由本机 mock 服务按 model 名回吐，因此整条链路（提示词渲染 → 上下文装配 → 解析 → schema 校验 → 去重）都是真实代码，只有模型换成确定性回放：不联网、不消耗额度。新增样例只要在 samples 数组里追加一条，再跑 --update-baseline 记录基线。",
  "samples": [
    {
      "id": "case_login_typical",
      "capability": "case_generation",
      "title": "验证码登录 · 典型产出",
      "variables": {
        "requirement": "手机号 + 验证码登录：验证码 5 分钟有效，同一手机号 60 秒内只能发送一次，连续 5 次错误锁定 10 分钟",
        "projectName": "示例电商项目",
        "caseTypes": "functional,boundary,exception",
        "count": "4"
      },
      "fixture": [
        {
          "title": "正确的手机号和验证码可以登录成功",
          "caseType": "functional",
          "priority": "P0",
          "preconditions": "用户已注册且未锁定",
          "steps": [
            { "action": "输入已注册手机号", "expected": "格式校验通过" },
            { "action": "获取并输入有效验证码", "expected": "验证码在 5 分钟内可用" },
            { "action": "点击登录", "expected": "登录成功并返回 token" }
