            { "action": "第 5 次输入错误验证码", "expected": "提示账号已锁定" },
            { "action": "锁定期内再次登录", "expected": "仍然拒绝并提示剩余时间" }
          ],
          "expectedResult": "锁定生效且提示剩余分钟数",
          "tags": "登录/异常"
        }
      ]
    },
