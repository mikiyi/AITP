          "expectedResult": "登录成功，跳转首页",
          "tags": "登录/正向"
        },
        {
          "title": "验证码超过 5 分钟后提交被拒绝",
          "caseType": "boundary",
          "priority": "P1",
          "preconditions": "验证码已获取满 5 分钟",
          "steps": [{ "action": "输入过期验证码并点击登录", "expected": "提示验证码已失效" }],
          "expectedResult": "登录失败，提示重新获取",
          "tags": "登录/边界"
        },
        {
          "title": "60 秒内重复发送验证码被限流",
          "caseType": "boundary",
          "priority": "P1",
          "preconditions": "刚发送过一次验证码",
          "steps": [{ "action": "再次点击发送验证码", "expected": "提示发送过于频繁" }],
          "expectedResult": "不重复下发短信",
          "tags": "登录/边界"
        },
        {
          "title": "连续 5 次验证码错误后账号锁定 10 分钟",
          "caseType": "exception",
          "priority": "P0",
          "preconditions": "同一手机号已连续输错 4 次",
