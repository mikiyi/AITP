# ── 服务 ──────────────────────────────────────────────────────────
AITP_HOST=127.0.0.1
AITP_PORT=8760
AITP_DEBUG=false
# 默认只允许绑定回环地址；确需对外暴露时显式设为 1
# AITP_ALLOW_PUBLIC_BIND=0

# ── 路径（相对项目根目录）────────────────────────────────────────
AITP_DB_PATH=data/aitp.db
AITP_LOG_PATH=data/aitp.log
AITP_DEPLOY_LOG_PATH=logs/deploy.log
AITP_SECRET_KEY_PATH=data/.secret_key
AITP_PROMPTS_DIR=backend/prompts
AITP_STATIC_DIR=backend/aitp/static

# ── AI 默认配置 ──────────────────────────────────────────────────
# 优先级：工作台配置(数据库) > 环境变量 > 内置默认
# AITP_AI_PROVIDER=openai
# AITP_AI_BASE_URL=https://api.openai.com/v1
# AITP_AI_API_KEY=
# AITP_AI_MODEL=gpt-4o-mini
# AI 调用默认超时 60 秒，可在「设置 → 系统配置」改 ai.timeout.default

# ── 各厂商环境变量 ───────────────────────────────────────────────
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# DASHSCOPE_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# OLLAMA_HOST=http://127.0.0.1:11434
